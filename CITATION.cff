cff-version: 1.2.0
title: >-
  Hierarchical Intent-Aware Routing for Hybrid VLC/RF VANET-FANET
  Networks: code and datasets
message: >-
  If you use this software or these datasets, please cite both this
  repository and the accompanying paper.
type: software
authors:
  - given-names: Mohit Kumar
    family-names: Thakur
    email: mohitthakur@ece.du.ac.in
    affiliation: >-
      Department of Electronics and Communication Engineering, Faculty of
      Technology, University of Delhi, Delhi, India
  - given-names: Gurinder
    family-names: Singh
    email: gurindersingh@ece.du.ac.in
    affiliation: >-
      Department of Electronics and Communication Engineering, Faculty of
      Technology, University of Delhi, Delhi, India
  - given-names: Vivek Ashok
    family-names: Bohara
